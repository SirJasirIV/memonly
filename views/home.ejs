<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
</head>
<body>
    <% messages.forEach(message => { %>
     <h1><%= message.created_at %></h1>
     <% if (isMember) {%>
     <h2><%= message.username %></h2>
     <% } %>
    <p><%= message.text %></p>
    <% }) %>
</body>
</html>