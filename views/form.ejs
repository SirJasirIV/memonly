<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
</head>
<body>
    <h1>YOOOO WORKING</h1>
    <form action="/sign-up" method="post">
        <label for="firstName"><i>Enter your first name *</i></label>
        <input type="text" name="firstName" placeholder="jane">
        <label for="secondName">Enter your second name *</label>
        <input type="text" name="secondName" placeholder="second name">
        <label for="username">Enter your public username *</label>
        <input type="text" name="username" placeholder="username">
        <label for="password">Enter your password</label>
        <input name="password" type="password" placeholder="password">
        <button type="submit">Submit</button>
    </form>
</body>
</html>